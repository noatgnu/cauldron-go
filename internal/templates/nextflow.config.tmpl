params {
    {{- range .Params }}
    {{ .Name }} = {{ .Default }}
    {{- end }}
}

profiles {
    docker {
        docker.enabled = true
        docker.userEmulation = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
}
