{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "cauldron-forms": {
      "projectType": "library",
      "root": "projects/cauldron-forms",
      "sourceRoot": "projects/cauldron-forms/src",
      "prefix": "cld",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/cauldron-forms/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/cauldron-forms/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/cauldron-forms/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
