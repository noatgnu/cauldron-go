{
  "name": "cauldron-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@cauldron/forms": "file:../shared-lib/dist/cauldron-forms",
    "@wailsio/runtime": "^3.0.0-alpha.74",
    "angular-plotly.js": "^22.0.1",
    "data-forge": "^1.10.4",
    "material-icons": "^1.13.14",
    "plotly.js-dist-min": "^3.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typeface-roboto": "^1.1.13",
    "uniprotparserjs": "^1.0.31"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.16.0",
    "@types/plotly.js-dist-min": "^2.3.4",
    "jsdom": "^27.1.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
